# Copy thành .env rồi điền. Ký tự $ trong mật khẩu phải viết $$ (docker compose coi $ là biến).

# Docker network mà container SQL Server có sẵn đang dùng (docker inspect <container-sql> → NetworkSettings.Networks).
# Container SQL đang ở network mặc định "bridge" thì tạo network riêng rồi nối vào:
#   docker network create sqlnet && docker network connect sqlnet <container-sql>
DB_NETWORK=sqlnet

# Server = tên container SQL Server trong network trên. Login cần quyền tạo DB (lần đầu) hoặc tạo sẵn DB BoschHomeVn.
DB_CONNECTION=Server=mssql,1433;Database=BoschHomeVn;User Id=sa;Password=doi-mat-khau;TrustServerCertificate=True

# Tài khoản admin tạo lúc khởi động lần đầu (khi DB chưa có admin). Mật khẩu ≥ 8 ký tự, có chữ thường, số, ký tự đặc biệt.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bosch-homevn.com
ADMIN_PASSWORD=

# Cổng cho reverse proxy trỏ vào. 127.0.0.1 = chỉ mở trong máy (proxy chạy trên host); proxy chạy trong container
# khác thì đổi BIND_ADDRESS=0.0.0.0 hoặc cho proxy tham gia network "bosch-homevn_app".
BIND_ADDRESS=127.0.0.1
WEBSTORE_PORT=8081
ADMIN_PORT=8082
