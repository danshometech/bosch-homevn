# Copy thành .env rồi điền. Ký tự $ trong mật khẩu phải viết $$ (docker compose coi $ là biến).

# Docker network mà container PostgreSQL dùng chung đang ở (vd. "dbnet").
# Kiểm tra: docker inspect <container-postgres> → NetworkSettings.Networks.
DB_NETWORK=dbnet

# Host = tên container PostgreSQL trong network trên. User nên là chủ DB (để migration tạo được extension unaccent).
DB_CONNECTION=Host=postgres;Port=5432;Database=boschhomevn;Username=boschhomevn;Password=doi-mat-khau

# Tài khoản admin tạo lúc khởi động lần đầu (khi DB chưa có admin). Mật khẩu ≥ 8 ký tự, có chữ thường, số, ký tự đặc biệt.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bosch-homevn.com
ADMIN_PASSWORD=

# Cổng cho reverse proxy trỏ vào. 127.0.0.1 = chỉ mở trong máy (proxy chạy trên host); proxy chạy trong container
# khác thì đổi BIND_ADDRESS=0.0.0.0 hoặc cho proxy tham gia network "bosch-homevn_app".
BIND_ADDRESS=127.0.0.1
WEBSTORE_PORT=8081
ADMIN_PORT=8082

# API danh mục địa chỉ hành chính Việt Nam (34 tỉnh / thành → phường / xã) cho form thanh toán.
# Bỏ trống thì dùng mặc định https://provinces.open-api.vn/api/v2/ — container api phải ra được internet.
VIETNAM_ADDRESS_API_URL=https://provinces.open-api.vn/api/v2/

# Cloudflare Turnstile chống spam đặt hàng: dash.cloudflare.com → Turnstile → Add widget (thêm tên miền site,
# chế độ Managed) rồi chép Site Key / Secret Key vào đây. Container webstore phải ra được internet (HTTPS).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backup hằng ngày lên Google Drive (deploy/backup.sh, xem README → Backup).
# Tên container PostgreSQL để chạy pg_dump; bỏ trống = Host trong DB_CONNECTION.
PG_CONTAINER=
# (Tùy chọn) URL ping healthchecks.io — email báo khi backup lỗi hoặc không chạy.
BACKUP_PING_URL=
